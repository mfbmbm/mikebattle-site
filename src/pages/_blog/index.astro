---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';

const letters = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Blog - Mike Battle">
  <div class="screenplay">
    <h1 class="page-title">Blog</h1>
    <ul class="letter-list">
      {letters.map((letter) => (
        <li>
          <a href={`/blog/${letter.id}`}>{letter.data.title}</a>
          <div class="meta">{letter.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
          <div class="desc">{letter.data.description}</div>
        </li>
      ))}
    </ul>
    <Signup />
  </div>
</Base>
