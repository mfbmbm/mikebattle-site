---
import Base from '../layouts/Base.astro';
---
<Base title="Contact - Mike Battle">
  <div class="screenplay plain">
    <h1 class="page-title">Contact</h1>

    <div class="contact-block">
      <div class="label">Email</div>
      <div class="value"><a href="mailto:mikefbattle@gmail.com">mikefbattle@gmail.com</a></div>
    </div>

    <div class="contact-block">
      <div class="label">Twitter / X</div>
      <div class="value"><a href="https://twitter.com/mikefbattle" target="_blank" rel="noopener">@mikefbattle</a></div>
    </div>

    <hr class="divider" />

    <h2 class="section-title">Story Tips</h2>
    <p>To write, I need to live. And to live well, I need stories.</p>
    <p>If you've stumbled across something strange, true, forgotten, or just quietly extraordinary — a world I haven't heard of, a person I should know about, a door that probably shouldn't be opened — I want to hear it.</p>
    <p>Tip me off. No story too small, no rabbit hole too deep. Especially if it's weird.</p>

    <div class="contact-block">
      <div class="label">Story Tips Email</div>
      <div class="value"><a href="mailto:mikefbattle@gmail.com?subject=Story%20Tip">mikefbattle@gmail.com</a> — subject line: Story Tip</div>
    </div>
  </div>
</Base>
