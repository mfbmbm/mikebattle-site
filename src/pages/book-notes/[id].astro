---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
---
<Base title={d.seoTitle ?? d.title} description={d.description}>
  <div class="screenplay">
    <article class="prose">
      <h1>{d.book} by {d.author}</h1>
      <Content />
      <p class="foot">
        {d.amazon && (<Fragment><a href={d.amazon} target="_blank" rel="sponsored noopener">Buy the book on Amazon</a> (affiliate link).</Fragment>)}
        {d.related && (<Fragment> Related: <a href={d.related.url} target="_blank" rel="noopener">{d.related.text}</a>.</Fragment>)}
      </p>
    </article>
    <p style="margin-top:32px"><a class="inline-link" href="/book-notes">← All book notes</a></p>
  </div>
</Base>
